#
# Media preview AP default config (H264E stream + ISP frame).
#
# CONFIG_BUILD_DEFAULT_VERSION is not set
# CONFIG_DEBUG_VERSION is not set
CONFIG_RELEASE_VERSION=y

CONFIG_ISP=y
CONFIG_MIPI_CSI=y
CONFIG_BK_CAMERA=y
CONFIG_CSI_CAMERA=y
# Multi-sensor: compile all drivers, runtime auto-detect picks the mounted sensor
CONFIG_CSI_GC2053=y
CONFIG_CSI_CV2005=y
CONFIG_CSI_SC3336=y
CONFIG_FRAME_BUFFER=y
CONFIG_MEDIA_SERVICE=y
CONFIG_BK_PERIPHERAL=y

CONFIG_BK_ENCODER=y
CONFIG_BK_ENCODER_H264_TASK_SIZE=5120
CONFIG_BK_H264E=y
CONFIG_H264E_STREAM_SESSION=y
CONFIG_ISP_FRAME_SESSION=y
CONFIG_CJSON_USE=y
CONFIG_VG_LITE_GPU=y
CONFIG_APP_GPU=y    

CONFIG_BK_NTWK_TRANSFER=y
CONFIG_NTWK_CTRL_CHAN_JSON=y
CONFIG_NTWK_CTRL_CHAN_PASSTHROUGH=y
# WiFi runs on the CP core; the AP reaches it through the VNET controller
# (CONFIG_WIFI_VNET_CONTROLLER). Enabling CONFIG_WIFI_ENABLE here would pull
# the CP-only RWNX hooks into the AP lwip and break the link.
# CONFIG_WIFI_ENABLE is not set
CONFIG_LWIP=y
CONFIG_BK_NETIF=y
CONFIG_CLI_TASK_STACK_SIZE=1536
# CONFIG_WIFI_CLI_DEBUG is not set

CONFIG_FREERTOS_USE_QUEUE_SETS=y
CONFIG_TASK_STACK_IN_PSRAM=y
CONFIG_QUEUE_IN_PSRAM=y
CONFIG_LWIP_MEM_LIBC_MALLOC_USE_PSRAM=y
CONFIG_CONTROLLER_AP_BUFFER_COPY=y
CONFIG_DUMP_UART_MEM_ENCODING_ASCII=y
CONFIG_DUMP_BY_LOG_UART=y
CONFIG_EASY_FLASH_V4=y

CONFIG_DMA_LOGIC_CHAN_CNT=16
CONFIG_DMA_LOGIC_CHAN_ID_MIN=0
CONFIG_XTAL_FREQ=12000000
CONFIG_SYS_PRINT_DEV_MAILBOX=y

CONFIG_BK_DISPLAY=y
CONFIG_MIPI_DSI=y
CONFIG_DPU_DRIVER=y
CONFIG_DSI_DRIVER=y
CONFIG_LCD_DSI=y
CONFIG_LCD_HX8399C_MIPI_1080x1920=y
CONFIG_ENCODER_H264_CLK_240M=y

# CONFIG_BLUETOOTH_AP is not set
# CONFIG_BLUETOOTH_BLE_SLAVE_ONLY is not set
# CONFIG_USB is not set
# CONFIG_BK_DECODER is not set
